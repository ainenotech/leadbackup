# --- Lead dataset ---
LEADS_FILE=leads.xlsx
STALE_AFTER_DAYS=90

# --- Database (Postgres) ---
# Campaign log AND the RAG knowledge base both live here.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lead_reengagement

# --- LLM (composer + reply agent) ---
# "gemini" (default) or "claude"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- RAG (reply-agent knowledge base) ---
# Embeddings always use Gemini's embedding API, even if LLM_PROVIDER=claude
# (Anthropic has no public embeddings endpoint) — GEMINI_API_KEY above is
# required for this either way.
EMBEDDING_MODEL=models/text-embedding-004

# --- Email & Calendar Services (Microsoft 365 / Outlook / Teams) ---
# "outlook" (default)
EMAIL_PROVIDER=outlook

# Azure AD app registration (Azure Portal -> App registrations -> New
# registration), with APPLICATION (not delegated) permissions granted admin
# consent: Mail.Send, Mail.Read, Calendars.ReadWrite.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The shared company support mailbox that outreach/reply emails are sent
# from and read from, and whose calendar is used for scheduling + Teams links.
MS_SENDER_EMAIL=support@nenotechnology.com

# Custom Meeting Form base URL (form available at FORM_BASE_URL/meeting-request)
FORM_BASE_URL=http://localhost:8000
# Primary Consultation / Meeting Booking URL (Microsoft Bookings)
BOOKING_FORM_URL=https://bookings.cloud.microsoft/book/Copy@nenotechnology.com/s/GAyi4UyD0E--hWIuusbLzg2?ismsaljsauthenabled
CAMPAIGN_NAME=q3_stale_lead_reengagement

# --- Scheduling ---
OFFICE_HOURS_TZ=Asia/Kolkata
OFFICE_HOURS_START=09:00
OFFICE_HOURS_END=18:00
OFFICE_HOURS_DAYS=0,1,2,3,4
MEETING_DURATION_MINUTES=30
AVAILABILITY_LOOKAHEAD_DAYS=14

# "auto_propose" (default) emails the lead fresh alternate times when none
# of their submitted slots are free in office hours. "manual_flag" instead
# leaves the row for a human — see dashboard.py's Booking status tab.
SCHEDULING_FALLBACK=auto_propose
AUTO_PROPOSE_LOOKAHEAD_DAYS=7
AUTO_PROPOSE_SLOT_COUNT=3



